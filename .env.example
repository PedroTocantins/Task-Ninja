# Port the HTTP server listens on
PORT=3000

# development | production | test
NODE_ENV=development

# Path to the JSON file used as the data source (relative to the project root)
TASKS_FILE_PATH=data/tasks.json

# PostgreSQL credentials (used by docker-compose to create the database)
POSTGRES_USER=taskninja
POSTGRES_PASSWORD=taskninja
POSTGRES_DB=taskninja
POSTGRES_PORT=5432

# Connection string used by the app: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Must match the POSTGRES_* values above
DATABASE_URL=postgres://taskninja:taskninja@localhost:5432/taskninja
